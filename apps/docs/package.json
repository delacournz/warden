{
	"name": "@delacour/warden-docs",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"dev": "bun run release-notes && vite dev",
		"build": "bun run release-notes && bun run seo:assets && vite build",
		"seo:assets": "bun run scripts/generate-og.ts",
		"og:cards": "bun run scripts/generate-og.ts --sheet",
		"release-notes": "bun run scripts/generate-release-notes.ts",
		"start": "bun --preload ./src/server/otel-preload.ts .output/server/index.mjs",
		"fmt": "biome format --write ./src ./scripts",
		"lint": "biome lint --write ./src ./scripts",
		"check": "biome check ./src ./scripts",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@delacour/warden-e2e-bench": "workspace:*",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@fontsource-variable/mona-sans": "5.3.0",
		"@fontsource/chakra-petch": "5.3.0",
		"@tanstack/react-router": "1.170.27",
		"@tanstack/react-start": "1.168.44",
		"fumadocs-core": "16.15.1",
		"fumadocs-mdx": "15.3.1",
		"fumadocs-ui": "npm:@fumadocs/base-ui@16.15.1",
		"lucide-react": "^1.31.0",
		"posthog-js": "^1.438.12",
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"optionalDependencies": {
		"@delacournz/otel": "0.1.0",
		"@delacournz/otel-start": "0.1.0"
	},
	"devDependencies": {
		"@fontsource/martian-mono": "5.3.0",
		"@fontsource/mona-sans": "5.3.0",
		"@resvg/resvg-wasm": "^2.6.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/mdx": "^2.0.14",
		"@types/react": "19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"isbot": "^5.2.2",
		"nitro": "3.0.260610-beta",
		"satori": "0.12.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.1"
	}
}
