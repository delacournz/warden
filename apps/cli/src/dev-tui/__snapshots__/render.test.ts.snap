exports[`render help overlay at 80x24 1`] = `
"warden dev
  ✓ claim device      1.3s│ fingerprint abc123
  · show simulator        │ a very long line that has to wrap because the log pa
› ▶ dev build             │ ne is narrower than it: /Users/chris/project/node_mo
  · metro                 │ dules/.bin/expo
 ┌ keys ──────────────────────────────────────────────────────────────────────┐
 │ warden                                            Expo (interact)          │
 │ ↑ ↓ j k  select task     l        device logs     a        open Android    │
 │ enter i  interact Metro  p        perf on/off     i        open iOS sim    │
 │ tab      focus log       P        perf all        w        open web        │
 │ r        reload app      m        perf mark       j        open debugger   │
 │ d        show sim        f        frames          r        reload app      │
 │ o        open client     g        perf report     m        dev menu        │
 │ s        screenshot      h        toggle HUD      shift+m  more tools      │
 │ R        reinstall app   ?        help            o        open in editor  │
 │ x        restart sim     q ctrl-c quit, release   ?        all commands    │
 │ c        Metro --clear   ctrl-l   redraw                                   │
 │ tab: scroll the log                               esc ? q close            │
 └────────────────────────────────────────────────────────────────────────────┘
                          │
                          │
                          │
                          │
esc close · ctrl-c quit"
`;

