exports[`help output warden sim --help (and nested subcommands) 1`] = `
"$ warden sim --help
Usage: warden sim [options] [command]

per-simulator tweaks: slim | unquarantine

Options:
  -h, --help         display help for command

Commands:
  slim [udid]        switch off the iOS simulator daemons UI specs never need
                     (Siri, Health, News, Mail…) to save RAM/CPU
  unquarantine <id>  clear the quarantine on a device (set by \`release --bad\` or
                     a failed claim health probe)
  help [command]     display help for command

$ warden sim slim --help
Usage: warden sim slim [options] [udid]

switch off the iOS simulator daemons UI specs never need (Siri, Health, News,
Mail…) to save RAM/CPU

Arguments:
  udid        simulator udid (booted, not leased by another session)

Options:
  --booted    every booted simulator
  --dry-run   list the jobs, change nothing
  --restore   re-enable them (fully effective on the next boot)
  --json      machine-readable output
  -h, --help  display help for command

$ warden sim unquarantine --help
Usage: warden sim unquarantine [options] <id>

clear the quarantine on a device (set by \`release --bad\` or a failed claim
health probe)

Arguments:
  id          simulator udid / emulator serial

Options:
  -h, --help  display help for command"
`;

exports[`help output warden sims --help (and nested subcommands) 1`] = `
"$ warden sims --help
Usage: warden sims [options] [command]

simulator + runtime disk audit (default), prune idle warden sims, delete
(multi-select)

Options:
  -h, --help            display help for command

Commands:
  audit                 every sim + downloaded runtime: size, owner, lease, last
                        use, verdict (the default; read-only)
  prune                 delete warden sims the audit marks deletable (never
                        foreign sims or goldens)
  delete|rm [udids...]  pick simulators to delete from a menu (suggestions
                        pre-ticked) or pass udids, confirm, delete
  help [command]        display help for command

$ warden sims audit --help
Usage: warden sims audit [options]

every sim + downloaded runtime: size, owner, lease, last use, verdict (the
default; read-only)

Options:
  --idle <duration>   warden sims unused this long are deletable (default 7d)
  --stale <duration>  foreign sims not booted this long are suggested (default
                      30d)
  --max-size <size>   disk budget for all sims, e.g. 40G — LRU warden sims over
                      it are deletable
  --owner <owner>     warden | golden | foreign | all (default all)
  --json              machine-readable output
  -h, --help          display help for command

$ warden sims prune --help
Usage: warden sims prune [options]

delete warden sims the audit marks deletable (never foreign sims or goldens)

Options:
  --idle <duration>  warden sims unused this long are deletable (default 7d)
  --max-size <size>  also delete least-recently-used warden sims until all sims
                     fit, e.g. 40G
  --dry-run          only show what would be deleted
  --yes              don't ask before deleting
  --json             machine-readable output
  -h, --help         display help for command

$ warden sims delete --help
Usage: warden sims delete|rm [options] [udids...]

pick simulators to delete from a menu (suggestions pre-ticked) or pass udids,
confirm, delete

Arguments:
  udids               delete these instead of showing the menu

Options:
  --suggested         delete every suggested sim instead of showing the menu
  --stale <duration>  foreign sims not booted this long are suggested (default
                      30d)
  --idle <duration>   warden sims unused this long are deletable (default 7d)
  -y, --yes           don't ask before deleting
  --dry-run           only show what would be deleted
  --json              machine-readable output
  -h, --help          display help for command"
`;

