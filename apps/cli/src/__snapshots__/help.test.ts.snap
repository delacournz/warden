exports[`help output warden app --help (and nested subcommands) 1`] = `
"$ warden app --help
Usage: warden app [options] [command]

fingerprint an Expo app and install the matching build (installed → cache → EAS
→ local build)

Options:
  -h, --help              display help for command

Commands:
  ensure [platform]       install the build matching the project's fingerprint
                          on a device (installed → cache → EAS → build)
  fingerprint [platform]  print the project's native fingerprint (both platforms
                          by default)
  help [command]          display help for command

$ warden app ensure --help
Usage: warden app ensure [options] [platform]

install the build matching the project's fingerprint on a device (installed →
cache → EAS → build)

Arguments:
  platform               ios | android (asked for when omitted in a terminal)

Options:
  --project <dir>        project directory (default: cwd)
  --lease <id>           device of this lease
  --udid <udid>          this device
  --no-install           only resolve the build into the cache
  --no-eas               don't download EAS builds
  --no-build             don't build locally on a cache miss
  --install-mode <mode>  clean = fresh app data each run without reinstalling an
                         unchanged build; reinstall = uninstall + install each
                         run (default: install only when the build differs)
                         (choices: "clean", "reinstall")
  --reset-keychain       --install-mode: also reset the iOS simulator's keychain
  --bundle-id <id>       override the bundle id / package
  --variant <name>       use this projects[].variants build (dev, e2e…)
  --kind <kind>          install this build kind: dev (Debug, Metro), simulator
                         (Release + this worktree's JS repacked in seconds),
                         release (JS embedded at build) (choices: "dev",
                         "simulator", "release")
  --json                 machine-readable output
  -h, --help             display help for command

$ warden app fingerprint --help
Usage: warden app fingerprint [options] [platform]

print the project's native fingerprint (both platforms by default)

Arguments:
  platform          ios | android

Options:
  --project <dir>   project directory (default: cwd)
  --bundle-id <id>  override the bundle id / package
  --variant <name>  fingerprint this projects[].variants build
  --json            machine-readable output
  -h, --help        display help for command"
`;

