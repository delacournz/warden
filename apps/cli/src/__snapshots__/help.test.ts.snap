exports[`help output warden builds --help (and nested subcommands) 1`] = `
"$ warden builds --help
Usage: warden builds [options] [command]

list, remove, prune (LRU) and import cached native app builds

Options:
  -h, --help           display help for command

Commands:
  ls                   list cached builds (the default)
  prune                remove least-recently-used builds until the cache fits
                       --max-size (build-locked ones stay)
  rm|remove <hash...>  remove cached builds by hash (or a unique prefix) and
                       forget the installs at that hash
  import <path>        copy a local .app / .apk into the cache under a
                       fingerprint hash
  help [command]       display help for command

$ warden builds ls --help
Usage: warden builds ls [options]

list cached builds (the default)

Options:
  --json      machine-readable output
  -h, --help  display help for command

$ warden builds prune --help
Usage: warden builds prune [options]

remove least-recently-used builds until the cache fits --max-size (build-locked
ones stay)

Options:
  --max-size <size>  cache size limit, e.g. 20G (default: $WARDEN_MAX_CACHE_SIZE
                     or 20G; gc's --max-cache-size)
  --dry-run          only show what would be removed
  --yes              don't ask before removing
  --json             machine-readable output
  -h, --help         display help for command

$ warden builds rm --help
Usage: warden builds rm|remove [options] <hash...>

remove cached builds by hash (or a unique prefix) and forget the installs at
that hash

Arguments:
  hash                   hash or unique prefix (at least 6 characters), as
                         \`warden builds\` shows it

Options:
  --platform <platform>  ios | android: only builds of this platform
  --dry-run              only show what would be removed
  --yes                  don't ask before removing
  --json                 machine-readable output
  -h, --help             display help for command

$ warden builds import --help
Usage: warden builds import [options] <path>

copy a local .app / .apk into the cache under a fingerprint hash

Arguments:
  path                   path.app | path.apk

Options:
  --hash <hash>          fingerprint hash to file it under
  --platform <platform>  ios | android (default: from the extension)
  --project <dir>        project directory (default: cwd)
  --profile <profile>    build profile (default: the project's EAS profile, else
                         local)
  --bundle-id <id>       override the bundle id / package
  --json                 machine-readable output
  -h, --help             display help for command"
`;

exports[`help output warden hook --help (and nested subcommands) 1`] = `
"$ warden hook --help
