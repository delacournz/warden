exports[`help output warden install --help (and nested subcommands) 1`] = `
"$ warden install --help
Usage: warden install [options]

install warden to ~/.local/bin + hooks for detected agents (Claude Code: skill,
rule, hook; Codex: hook)

Options:
  --claude         install for Claude Code (default: every detected agent)
  --codex          install for Codex (default: every detected agent)
  -y, --yes        apply agent-config changes without asking
  --dry-run        show what would change (diffs), write nothing
  --shim           running from source: link ~/.local/bin/warden to this
                   checkout
  --no-completion  don't set up tab completion for $SHELL
  --json           machine-readable output (diffs go to stderr)
  -h, --help       display help for command"
`;

exports[`help output warden init --help (and nested subcommands) 1`] = `
"$ warden init --help
Usage: warden init [options]

set an Expo app up for warden dev / warden e2e (warden.config.ts, a first spec)

Options:
  --project <dir>   the Expo app's directory (default: cwd)
  --bundle-id <id>  bundle id / package for an app that has none yet (written to
                    app.json)
  --force           overwrite files that already exist
  --dry-run         print what would be written, write nothing
  --json            machine-readable output
  -h, --help        display help for command

Example:
  warden init --bundle-id com.example.app"
`;

exports[`help output warden completion --help (and nested subcommands) 1`] = `
"$ warden completion --help
Usage: warden completion [options] [shell]

print the tab-completion script for zsh / bash / fish (\`warden install\` sets it
up)

Arguments:
  shell       default: $SHELL (choices: "zsh", "bash", "fish")

Options:
  -h, --help  display help for command

Load it in your shell:
  zsh   source <(warden completion zsh)
  bash  source <(warden completion bash)
  fish  warden completion fish | source"
`;

exports[`help output warden __complete --help (and nested subcommands) 1`] = `
"$ warden __complete --help
option	--help	display help for command"
`;

exports[`help output warden skill --help (and nested subcommands) 1`] = `
"$ warden skill --help
Usage: warden skill [options] [command]

the warden agent skill: show (copy/paste) | install (bunx/npx skills add)

Options:
  -h, --help      display help for command

Commands:
  show            print SKILL.md to copy/paste (e.g. \`warden skill show |
                  pbcopy\`)
  install         install via \`bunx skills add\` (npx fallback)
  help [command]  display help for command

$ warden skill show --help
Usage: warden skill show [options]

print SKILL.md to copy/paste (e.g. \`warden skill show | pbcopy\`)

Options:
  --file <path>  print one embedded file (references/ui.md, rules/warden.md, …)
  --json         machine-readable output
  -h, --help     display help for command

$ warden skill install --help
Usage: warden skill install [options]

install via \`bunx skills add\` (npx fallback)

Options:
  --from <source>         local = this binary's embedded copy; github = the
                          release repo (updatable) (choices: "local", "github",
                          default: "local")
  --project               install into the current project (default: global, -g)
  -a, --agent <agent...>  target agent(s), repeatable (default: the skills CLI
                          asks)
  --copy                  copy files instead of symlinking
  -y, --yes               skip the skills CLI's confirmations
  --dry-run               print the skills command, run nothing
  --json                  machine-readable output (with --dry-run: the command
                          as JSON)
  -h, --help              display help for command"
`;

