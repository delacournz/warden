  --leaks                 iOS: cold-launch the app with malloc stack logging and
                          report leaks (needs the device lease)
  --skip-analysis         stop: leave the trace unexported
  --flavor <name>         Android: perfetto | simpleperf
  --yes                   Android: download trace_processor without asking
  --udid <udid>           device udid (iOS) / serial (Android)
  --serial <serial>       Android serial
