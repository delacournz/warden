// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`help output warden --help 1`] = `
"Usage: warden [options] [command]

machine-wide device + port leasing for agents and users

Options:
  -h, --help                    display help for command

Lease:
  claim [platform]              lease iOS sims / Android emulators (reuse, boot
                                or create), booted and ready
  release [leaseIds...]         release leases (optionally shut down devices
                                warden created)
  ls                            list leases (resource, state, owner,
                                repo/worktree, age, heartbeat)
  capacity                      machine capacity: budget, booted devices
                                (foreign too), per-device cost, memory pressure
  queue                         claims waiting for host capacity, head first
                                (position, priority, age, owner)
  check                         exit 0 if a device is free or yours, 2 if
                                another owner holds it
  heartbeat [leaseIds...]       refresh lease heartbeats so they don't go stale
  gc                            reclaim stale leases; shut down idle warden
                                devices (never deletes)
  port                          lease TCP ports from a range (bind-probed, never
                                handed out twice)

Run:
  run [platform] [cmd...]       claim devices, run a command with WARDEN_UDIDS
                                set, release on exit
  dev [platform] [expoArgs...]  install the cached dev build for this
                                fingerprint, start Metro, open the dev client
                                (replaces expo run:*)
  batch [platform] [cmd...]     claim N devices, fan a job queue out over them
                                (one worker per device), release at the end
  affected [suite]              list the e2e specs a change needs (git diff vs
                                base → import graph → specs)
  e2e [suite]                   run the e2e specs a change needs on leased
                                devices; exit 1 if a required spec fails
  perf                          profile an app on a warden device: sessions,
                                marks, doctor (CPU, memory, frames, startup, JS,
                                React, native)

Devices:
  devices|list [platform]       list every simulator / emulator (booted or not,
                                plus Android AVDs) with warden ownership +
                                leases
  sim                           per-simulator tweaks: slim | profiles | measure
                                | unquarantine
  sims                          simulator + runtime disk audit (default), prune
                                idle warden sims, delete (multi-select)
  arrange                       tile warden simulator windows in name order
                                (macOS; also runs after iOS claims)
  clone <source>                duplicate a shut-down iOS simulator into
                                warden's pool (fast: no first boot)
  golden                        golden iOS images / Android snapshots new
                                devices start from (fast boots): ensure | ls |
                                prune

Builds:
  app                           fingerprint an Expo app and install the matching
                                build (installed → cache → EAS → local build)
  repack [platform]             bundle this worktree's JS into the cached
                                simulator build (seconds; builds the base once
                                per native fingerprint)
  builds                        list, remove, prune (LRU) and import cached
                                native app builds

Commands:
  ui                            drive a leased simulator / emulator (agents):
                                status, snapshot, find, open, press, fill,
                                scroll, …

Setup:
  hook                          Claude Code / Codex hook: on session end shut
                                down what the session booted + release its
                                leases
  install                       install warden to ~/.local/bin + hooks for
                                detected agents (Claude Code: skill, rule, hook;
                                Codex: hook)
  init                          set an Expo app up for warden dev / warden e2e
                                (warden.config.ts, a first spec)
  completion [shell]            print the tab-completion script for zsh / bash /
                                fish (\`warden install\` sets it up)
  skill                         the warden agent skill: show (copy/paste) |
                                install (bunx/npx skills add)
  doctor                        check warden's setup: home, db, device tools,
                                simulator helper, install method, PATH,
                                Claude/Codex hooks + skill, stale leases
  update                        update warden: rebuild from source (dev/local
                                builds) or install the latest release
  version                       print warden's version and build channel (dev /
                                local / release)
  mcp                           MCP server on stdio: Metro logs, app console,
                                network, eval, tree, logpoints, profiles of
                                \`warden dev\`
  help [command]                display help for command"
`;

exports[`help output warden claim --help (and nested subcommands) 1`] = `
"$ warden claim --help
Usage: warden claim [options] [platform]

lease iOS sims / Android emulators (reuse, boot or create), booted and ready

Arguments:
  platform               ios | android (asked for when omitted in a terminal)

Options:
  --profile <slug>       device profile, e.g. iphone-17 / pixel-10 (android
                         default: first AVD)
  --runtime <runtime>    runtime: latest, iOS-26-5, 26.5 …
  --count <n>            how many devices (default: "1")
  --max <n>              max warden devices of this profile (default: what the
                         machine's capacity allows)
  --wait <duration>      queue up to this long for a free device or host
                         capacity (default 30m)
  --no-wait              fail at once instead of queueing when no device is free
  --priority <priority>  boot-queue priority: interactive|high|normal|low or a
                         number (env WARDEN_PRIORITY; default by command)
  --ttl <duration>       lease TTL without heartbeat (default 30m; bare \`claim\`
                         by an agent: 5m)
  --label <label>        label shown in \`warden ls\`
  --adopt                allow allocating foreign (non-warden) devices
  --headless             iOS: close the claimed sims' Simulator.app windows (no
                         window, even with Simulator open)
  --no-headless          show the windows even when config / WARDEN_HEADLESS say
                         headless
  --slim                 iOS: slim the simulator daemons (default; ignored on
                         android)
  --no-slim              iOS: leave the simulator daemons running (config slim /
                         WARDEN_SLIM=0 also turn slimming off)
  --json                 machine-readable output
  --physical             claim a connected physical phone/tablet (never booted,
                         shut down or created by warden)
  --serial <serial...>   android: claim these physical devices by adb serial
                         (implies --physical)
  --udid <udid...>       ios: claim these physical devices by CoreDevice UDID
                         (implies --physical)
  -h, --help             display help for command"
`;

exports[`help output warden release --help (and nested subcommands) 1`] = `
"$ warden release --help
Usage: warden release [options] [leaseIds...]

release leases (optionally shut down devices warden created)

Arguments:
  leaseIds          lease ids to release

Options:
  --udid <udid...>  select leases of these device udids / serials (repeatable)
  --mine            select every lease held by this owner
  --label <label>   with --mine: only leases whose label equals this
  --session <id>    select every lease held by this agent session
  --shutdown        also shut down devices warden created (or the lease owner
                    booted)
  --bad [reason]    also quarantine the released devices (warden devices only)
                    so claims skip them
  --json            machine-readable output
  -h, --help        display help for command"
`;

exports[`help output warden run --help (and nested subcommands) 1`] = `
"$ warden run --help
Usage: warden run [options] [platform] [cmd...]

claim devices, run a command with WARDEN_UDIDS set, release on exit

Arguments:
  platform               ios | android (asked for when omitted in a terminal)
  cmd                    the command to run, after --

Options:
  --profile <slug>       device profile, e.g. iphone-17 / pixel-10 (android
                         default: first AVD)
  --runtime <runtime>    runtime: latest, iOS-26-5, 26.5 …
  --count <n>            how many devices (default: "1")
  --max <n>              max warden devices of this profile (default: what the
                         machine's capacity allows)
  --wait <duration>      queue up to this long for a free device or host
                         capacity (default 30m)
  --no-wait              fail at once instead of queueing when no device is free
  --priority <priority>  boot-queue priority: interactive|high|normal|low or a
                         number (env WARDEN_PRIORITY; default by command)
  --ttl <duration>       lease TTL without heartbeat (default 30m; bare \`claim\`
                         by an agent: 5m)
  --label <label>        label shown in \`warden ls\`
  --adopt                allow allocating foreign (non-warden) devices
  --headless             iOS: close the claimed sims' Simulator.app windows (no
                         window, even with Simulator open)
  --no-headless          show the windows even when config / WARDEN_HEADLESS say
                         headless
  --slim                 iOS: slim the simulator daemons (default; ignored on
                         android)
  --no-slim              iOS: leave the simulator daemons running (config slim /
                         WARDEN_SLIM=0 also turn slimming off)
  --json                 machine-readable output
  --port <from:span>     lease a port from FROM..FROM+SPAN-1 (inclusive) for the
                         child (WARDEN_PORT_<i>); repeatable (default: [])
  --app                  install the project's app (fingerprint → cache → EAS →
                         build) on each device first
  --install-mode <mode>  --app: clean = fresh app data each run without
                         reinstalling an unchanged build; reinstall = uninstall
                         + install each run (default: install only when the
                         build differs) (choices: "clean", "reinstall")
  --reset-keychain       --install-mode: also reset the iOS simulator's keychain
                         (not cleared by uninstall either)
  --project <dir>        --app: project directory (default: cwd)
  --bundle-id <id>       --app: override the bundle id / package
  --variant <name>       --app: install this projects[].variants build (dev,
                         e2e…)
  --kind <kind>          --app: install this build kind: dev (Debug, Metro),
                         simulator (Release + this worktree's JS repacked in
                         seconds), release (JS embedded at build) (choices:
                         "dev", "simulator", "release")
  --no-eas               --app: don't download EAS builds
  --no-build             --app: don't build locally on a cache miss
  -h, --help             display help for command

Example:
  warden run ios --count 2 --port 8091:20 -- bun e2e"
`;

exports[`help output warden dev --help (and nested subcommands) 1`] = `
"$ warden dev --help
Usage: warden dev [options] [command] [platform] [expoArgs...]

install the cached dev build for this fingerprint, start Metro, open the dev
client (replaces expo run:*)

Arguments:
  platform                    ios | android (default: ios)
  expoArgs                    extra \`expo start\` args, after --

Options:
  --profile <slug>            device profile, e.g. iphone-17 / pixel-10 (android
                              default: first AVD)
  --runtime <runtime>         runtime: latest, iOS-26-5, 26.5 …
  --max <n>                   max warden devices of this profile (default: what
                              the machine's capacity allows)
  --wait <duration>           queue up to this long for a free device or host
                              capacity (default 30m)
  --no-wait                   fail at once instead of queueing when no device is
                              free
  --priority <priority>       boot-queue priority: interactive|high|normal|low
                              or a number (env WARDEN_PRIORITY; default by
                              command)
  --ttl <duration>            lease TTL without heartbeat (default 30m; bare
                              \`claim\` by an agent: 5m)
  --label <label>             label shown in \`warden ls\`
  --adopt                     allow allocating foreign (non-warden) devices
  --headless                  iOS: close the claimed sims' Simulator.app windows
                              (no window, even with Simulator open)
  --no-headless               show the windows even when config /
                              WARDEN_HEADLESS say headless
  --slim                      iOS: slim the simulator daemons (default; ignored
                              on android)
  --no-slim                   iOS: leave the simulator daemons running (config
                              slim / WARDEN_SLIM=0 also turn slimming off)
  --json                      machine-readable output
  --udid <udid>               use this device instead of claiming one
  --lease <id>                use the device of this lease
  --port <from:span>          Metro port range to lease from (default:
                              "8081:100")
  --project <dir>             project directory (default: cwd)
  --bundle-id <id>            override the bundle id / package
  --variant <name>            projects[].variants build (default: dev when the
                              project has one)
  --scheme <scheme>           dev-client URL scheme (default: exp+<slug>)
  --ready-timeout <duration>  wait this long for Metro (default: "2m")
  --no-eas                    don't download EAS builds
  --no-build                  don't build locally on a cache miss
  --install-mode <mode>       clean = fresh app data each run without
                              reinstalling an unchanged build; reinstall =
                              uninstall + install each run (default: install
                              only when the build differs) (choices: "clean",
                              "reinstall")
  --reset-keychain            --install-mode: also reset the iOS simulator's
                              keychain
  --hud                       start the perf HUD sampler with the dashboard
                              (default off: h or \`warden dev enable hud\`)
  --hud-interval <duration>   HUD sampling interval, at least 200ms (default:
                              "1s")
  --devtools                  start the CDP devtools broker with the session
                              (default off: \`warden dev enable devtools\`)
  --no-open                   don't open the dev client (Metro + the leases
                              only)
  --no-tui                    plain output: Metro on this terminal, no dashboard
                              (also WARDEN_TUI=0; --json and pipes are always
                              plain)
  --no-shutdown               leave the simulator booted when dev ends (default:
                              shut down the one dev leased, unless it was
                              already running)
  -h, --help                  display help for command

Commands:
  logs                        Metro output of a running \`warden dev\` session,
                              classified (bundle errors, HMR, warnings)
  enable <features...>        start the perf HUD sampler and/or CDP devtools
                              broker of a running \`warden dev\` (both start off)
  disable <features...>       stop the perf HUD sampler and/or CDP devtools
                              broker of a running \`warden dev\` (both start off)
  status                      which extras (perf HUD, devtools broker) a running
                              \`warden dev\` has on

Examples:
  warden dev
  warden dev android -- --clear

$ warden dev logs --help
Usage: warden dev logs [options]

Metro output of a running \`warden dev\` session, classified (bundle errors, HMR,
warnings)

Options:
  --udid <udid>    the session on this device (default: the only running one)
  --since <when>   30s | 5m | ISO time: entries seen since (metro.log has no
                   per-line times, so this only skips a log not written since,
                   and filters followed entries)
  --tail <n>       only the last N matching entries
  --grep <regexp>  entries whose text matches (case-insensitive)
  --kind <kinds>   comma list of
                   bundle_start,bundle_done,bundle_failed,hmr,error,warn,info
  --follow         keep printing new entries until interrupted
  --json           one JSON object per line
  -h, --help       display help for command

$ warden dev enable --help
Usage: warden dev enable [options] <features...>

start the perf HUD sampler and/or CDP devtools broker of a running \`warden dev\`
(both start off)

Arguments:
  features       hud | perf | devtools | all (comma or space separated)

Options:
  --udid <udid>  the session on this device (default: the only running one)
  --json         print { udid, features } as JSON
  -h, --help     display help for command

$ warden dev disable --help
Usage: warden dev disable [options] <features...>

stop the perf HUD sampler and/or CDP devtools broker of a running \`warden dev\`
(both start off)

Arguments:
  features       hud | perf | devtools | all (comma or space separated)

Options:
  --udid <udid>  the session on this device (default: the only running one)
  --json         print { udid, features } as JSON
  -h, --help     display help for command

$ warden dev status --help
Usage: warden dev status [options]

which extras (perf HUD, devtools broker) a running \`warden dev\` has on

Options:
  --udid <udid>  the session on this device (default: the only running one)
  --json         print { udid, features } as JSON
  -h, --help     display help for command"
`;

exports[`help output warden batch --help (and nested subcommands) 1`] = `
"$ warden batch --help
Usage: warden batch [options] [platform] [cmd...]

claim N devices, fan a job queue out over them (one worker per device), release
at the end

Arguments:
  platform                    ios | android (asked for when omitted in a
                              terminal), or a warden.config.ts batches preset
  cmd                         per-job command after --; {job} {udid} {worker}
                              {seq} are substituted

Options:
  --profile <slug>            device profile, e.g. iphone-17 / pixel-10 (android
                              default: first AVD)
  --runtime <runtime>         runtime: latest, iOS-26-5, 26.5 …
  --count <n>                 how many devices (default: "1")
  --max <n>                   max warden devices of this profile (default: what
                              the machine's capacity allows)
  --wait <duration>           queue up to this long for a free device or host
                              capacity (default 30m)
  --no-wait                   fail at once instead of queueing when no device is
                              free
  --priority <priority>       boot-queue priority: interactive|high|normal|low
                              or a number (env WARDEN_PRIORITY; default by
                              command)
  --ttl <duration>            lease TTL without heartbeat (default 30m; bare
                              \`claim\` by an agent: 5m)
  --label <label>             label shown in \`warden ls\`
  --adopt                     allow allocating foreign (non-warden) devices
  --headless                  iOS: close the claimed sims' Simulator.app windows
                              (no window, even with Simulator open)
  --no-headless               show the windows even when config /
                              WARDEN_HEADLESS say headless
  --slim                      iOS: slim the simulator daemons (default; ignored
                              on android)
  --no-slim                   iOS: leave the simulator daemons running (config
                              slim / WARDEN_SLIM=0 also turn slimming off)
  --json                      machine-readable output
  --port <from:span>          lease a port from FROM..FROM+SPAN-1 (inclusive)
                              for the child (WARDEN_PORT_<i>); repeatable
                              (default: [])
  --app                       install the project's app (fingerprint → cache →
                              EAS → build) on each device first
  --install-mode <mode>       --app: clean = fresh app data each run without
                              reinstalling an unchanged build; reinstall =
                              uninstall + install each run (default: install
                              only when the build differs) (choices: "clean",
                              "reinstall")
  --reset-keychain            --install-mode: also reset the iOS simulator's
                              keychain (not cleared by uninstall either)
  --project <dir>             --app: project directory (default: cwd)
  --bundle-id <id>            --app: override the bundle id / package
  --variant <name>            --app: install this projects[].variants build
                              (dev, e2e…)
  --kind <kind>               --app: install this build kind: dev (Debug,
                              Metro), simulator (Release + this worktree's JS
                              repacked in seconds), release (JS embedded at
                              build) (choices: "dev", "simulator", "release")
  --no-eas                    --app: don't download EAS builds
  --no-build                  --app: don't build locally on a cache miss
  --retry <n>                 re-run a failed job up to N times on the same
                              device (default: "0")
  --passes <n>                a job passes after N consecutive green runs on its
                              device (default: "1")
  --serve <sh-cmd>            start this (sh -c, own process group) before the
                              jobs; killed at the end; {port} = the first leased
                              port
  --serve-ready <probe>       wait for http://…, tcp:PORT or file:PATH before
                              starting jobs (tcp:{port} works)
  --serve-timeout <duration>  --serve-ready: give up after this long (default:
                              "10m")
  --job-timeout <duration>    kill a job still running after this long (it
                              counts as failed)
  --record <dir>              iOS: record every simulator + the TUI into DIR
                              (batch.json, tui.cast, dev-<i>.mp4)
  --logs <dir>                per-job logs (default: <record dir>/logs or
                              $WARDEN_HOME/batches/<id>/logs)
  --no-tui                    plain log lines instead of the live grid
  --jobs <list>               comma-separated jobs
  --jobs-from <file>          one job per line from a file, or - for stdin
  -h, --help                  display help for command

Examples:
  warden batch ios --count 3 --jobs a,b,c,d -- bun e2e --spec {job} --device {udid}
  warden batch e2e --count 2    # batches.e2e from warden.config.ts, --count overridden"
`;

exports[`help output warden affected --help (and nested subcommands) 1`] = `
"$ warden affected --help
Usage: warden affected [options] [suite]

list the e2e specs a change needs (git diff vs base → import graph → specs)

Arguments:
  suite                  e2e.<suite> in warden.config.ts (optional with one
                         suite)

Options:
  --base <ref>           compare against merge-base with this ref (default: the
                         suite's base, main)
  --platform <platform>  ios | android (default: the suite's platform, else
                         both)
  --files <list>         comma-separated changed files (relative to cwd) instead
                         of git
  --required-only        only specs with required: true
  --explain              show why each spec was selected
  --strict               exit 3 when a changed file reaches no spec
  --json                 machine-readable output
  -h, --help             display help for command

Examples:
  warden affected mobile --base origin/main --explain
  warden affected mobile --platform ios | warden batch ios --jobs-from - -- <runner> {job}"
`;

exports[`help output warden e2e --help (and nested subcommands) 1`] = `
"$ warden e2e --help
Usage: warden e2e [options] [suite]

run the e2e specs a change needs on leased devices; exit 1 if a required spec
fails

Arguments:
  suite                       e2e.<suite> in warden.config.ts (optional with one
                              suite)

Options:
  --profile <slug>            device profile, e.g. iphone-17 / pixel-10 (android
                              default: first AVD)
  --runtime <runtime>         runtime: latest, iOS-26-5, 26.5 …
  --count <n>                 how many devices (default: "1")
  --max <n>                   max warden devices of this profile (default: what
                              the machine's capacity allows)
  --wait <duration>           queue up to this long for a free device or host
                              capacity (default 30m)
  --no-wait                   fail at once instead of queueing when no device is
                              free
  --priority <priority>       boot-queue priority: interactive|high|normal|low
                              or a number (env WARDEN_PRIORITY; default by
                              command)
  --ttl <duration>            lease TTL without heartbeat (default 30m; bare
                              \`claim\` by an agent: 5m)
  --label <label>             label shown in \`warden ls\`
  --adopt                     allow allocating foreign (non-warden) devices
  --headless                  iOS: close the claimed sims' Simulator.app windows
                              (no window, even with Simulator open)
  --no-headless               show the windows even when config /
                              WARDEN_HEADLESS say headless
  --slim                      iOS: slim the simulator daemons (default; ignored
                              on android)
  --no-slim                   iOS: leave the simulator daemons running (config
                              slim / WARDEN_SLIM=0 also turn slimming off)
  --json                      machine-readable output
  --port <from:span>          lease a port from FROM..FROM+SPAN-1 (inclusive)
                              for the child (WARDEN_PORT_<i>); repeatable
                              (default: [])
  --app                       install the project's app (fingerprint → cache →
                              EAS → build) on each device first
  --install-mode <mode>       --app: clean = fresh app data each run without
                              reinstalling an unchanged build; reinstall =
                              uninstall + install each run (default: install
                              only when the build differs) (choices: "clean",
                              "reinstall")
  --reset-keychain            --install-mode: also reset the iOS simulator's
                              keychain (not cleared by uninstall either)
  --project <dir>             --app: project directory (default: cwd)
  --bundle-id <id>            --app: override the bundle id / package
  --variant <name>            --app: install this projects[].variants build
                              (dev, e2e…)
  --kind <kind>               --app: install this build kind: dev (Debug,
                              Metro), simulator (Release + this worktree's JS
                              repacked in seconds), release (JS embedded at
                              build) (choices: "dev", "simulator", "release")
  --no-eas                    --app: don't download EAS builds
  --no-build                  --app: don't build locally on a cache miss
  --retry <n>                 re-run a failed job up to N times on the same
                              device (default: "0")
  --passes <n>                a job passes after N consecutive green runs on its
                              device (default: "1")
  --serve <sh-cmd>            start this (sh -c, own process group) before the
                              jobs; killed at the end; {port} = the first leased
                              port
  --serve-ready <probe>       wait for http://…, tcp:PORT or file:PATH before
                              starting jobs (tcp:{port} works)
  --serve-timeout <duration>  --serve-ready: give up after this long (default:
                              "10m")
  --job-timeout <duration>    kill a job still running after this long (it
                              counts as failed)
  --record <dir>              iOS: record every simulator + the TUI into DIR
                              (batch.json, tui.cast, dev-<i>.mp4)
  --logs <dir>                per-job logs (default: <record dir>/logs or
                              $WARDEN_HOME/batches/<id>/logs)
  --no-tui                    plain log lines instead of the live grid
  --base <ref>                compare against merge-base with this ref (default:
                              the suite's base)
  --platform <platform>       ios | android (default: the suite's platform)
  --files <list>              comma-separated changed files (relative to cwd)
                              instead of git
  --all                       run every spec of the suite (after include /
                              exclude), skipping the git diff
  --specs <list>              run exactly these spec ids / globs
                              (comma-separated), skipping the git diff
  --required-only             only run specs with required: true
  --explain                   print why each spec was selected before running
  --dry-run                   select and explain, run nothing
  --report <file>             also write e2e-report.json here
  --devices <legs>            which e2e.<suite>.devices legs run: default | all
                              | <profile,…>
  --no-shutdown               keep the devices running after the gate passes
                              (default: shut down the ones warden created; suite
                              shutdown)
  --perf [captures]           profile every attempt (bare: metrics, frames,
                              logs; or --perf=react,js | all); reports land in
                              the attempt's perf/ dir
  --dev                       run on the dev client (kind dev) against a Metro
                              warden starts, not the repacked simulator build
  --no-warm                   skip pre-warming the iOS socket helper per device
                              (default: on; suite warmDrivers)
  -h, --help                  display help for command

Examples:
  warden e2e mobile --base origin/main --count 2
  warden e2e mobile --dev --all
  warden e2e --dry-run --files src/modules/chat/api.ts"
`;

exports[`help output warden perf --help (and nested subcommands) 1`] = `
"$ warden perf --help
Usage: warden perf [options] [command]

profile an app on a warden device: sessions, marks, doctor (CPU, memory, frames,
startup, JS, React, native)

Options:
  -h, --help                    display help for command

Commands:
  start                         open a perf session: arm metrics, logs, frames,
                                JS, React and native captures
  stop                          end the session: stop the captures, write
                                report.md + report.json
  record                        start, wait --duration, stop and report in one
                                call (Ctrl-C stops early)
  mark <label...>               annotate the running session's timeline
                                (commits, hangs and jank are tagged with the
                                last mark)
  report [id]                   the merged report of a session (default: the
                                newest for the device)
  query <id> <topic> [args...]  drill into a session: commits, cpu, stacks,
                                frames
  diff <a> <b>                  compare two sessions' reports (before/after a
                                fix); --fail-on regress exits 1 on a regression
  metrics                       CPU % and memory of the app over time
                                (min/avg/p95/max, memory growth); --watch draws
                                live sparklines
  memory                        memory breakdown of the app; --snapshot captures
                                a heap (iOS memgraph + leaks, Android .hprof),
                                pausing the app
  frames                        fps, janky %, dropped/frozen frames and the
                                worst jank windows (Android gfxinfo)
  startup                       cold/warm app start time: median and p90 over
                                --runs (kills and relaunches the app: needs your
                                lease or --claim)
  js                            Hermes JS CPU profile of the dev client,
                                source-mapped to file:line hotspots
                                (js/cpu.cpuprofile)
  heap                          Hermes heap snapshots: take one, diff two
  react                         React render profile of the dev client: hot
                                commits, costly components, ranked findings
  native [action]               native CPU, hangs and leaks: iOS xctrace (Time
                                Profiler + Hangs), Android perfetto /
                                simpleperf; start | stop, or one-shot
  logs                          the app's device logs, secrets redacted
                                (--follow streams; Ctrl-C exits 130)
  crashes                       crashes and ANRs of the app (iOS .ips reports,
                                Android crash log + dropbox)
  ls                            perf sessions (newest first); --devices lists
                                the warden devices a session could attach to
  doctor                        what profiling needs: xctrace / Xcode, adb +
                                device tools, trace_processor, Metro, a
                                profileable app
  tools                         install the helper binaries profiling needs
  help [command]                display help for command

$ warden perf start --help
Usage: warden perf start [options]

open a perf session: arm metrics, logs, frames, JS, React and native captures

Options:
  --udid <udid>           device udid (iOS) / serial (Android)
  --serial <serial>       Android serial
  --lease <id>            use the device behind this lease id
  --claim                 take over a stale/missing lease, or claim a device
                          when none is held
  --platform <platform>   platform for --claim with no device named: ios
                          (default) | android
  --physical              with --claim and no device named: claim a connected
                          phone, not an emulator
  --profile <slug>        device profile for --claim with no device named
  --runtime <runtime>     runtime for --claim with no device named
  --force                 drive the device even while a live warden process
                          (e2e, batch, run) holds your lease on it; your own
                          warden dev device is shared without it
  --timeout <ms>          deadline in milliseconds (default 5000)
  --json                  machine-readable output: one JSON document on stdout
  --app <id>              bundle id (iOS) / package (Android); default: the
                          foreground app, then warden.config
  --allow-mutate-foreign  let a mutating step act on a device someone else holds
                          (refused while a live warden process holds it)
  --js                    Hermes JS CPU profile, source-mapped (needs Metro)
  --react                 React render profile (needs a dev client)
  --native [flavor]       native CPU + hangs: iOS xctrace, Android perfetto (or
                          =simpleperf)
  --metrics               CPU and memory every second
  --frames                fps and jank (Android)
  --logs                  the app's device logs, redacted
  --all                   every capture above
  --relaunch              stop the app, arm the captures, launch it: startup and
                          early JS/React are recorded
  --reset                 like --relaunch, but wipe the app's data first (same
                          build)
  --max-duration <time>   hard cap on the session (default 30s, max 5m)
  --yes                   download tools the analysis needs (trace_processor)
                          without asking
  --join                  attach read-only to the device's running session (id,
                          marks) instead of starting one
  -h, --help              display help for command

