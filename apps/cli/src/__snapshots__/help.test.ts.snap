exports[`help output warden __affected-graph --help (and nested subcommands) 1`] = `
"$ warden __affected-graph --help
Usage: warden __affected-graph [options] <request>

walk the import graph for \`warden affected\` and print it as JSON (internal)

Arguments:
  request     the graph request, as JSON

Options:
  -h, --help  display help for command"
`;

exports[`help output warden ui-collect --help (and nested subcommands) 1`] = `
"$ warden ui-collect --help
Usage: warden ui-collect [options]

background console + network collector for \`warden ui logs start\` (internal)

Options:
  --metro <url>
  --out <dir>
  --idle-ms <n>
  --device-name <name>
  --logical-device-id <id>
  --app-id <id>
  --include-bodies
  -h, --help                display help for command"
`;

exports[`help output warden perf-collect --help (and nested subcommands) 1`] = `
"$ warden perf-collect --help
Usage: warden perf-collect [options]

background sampler + auto-stop timer for \`warden perf start\` (internal)

Options:
  --session <id>
  -h, --help      display help for command"
`;

exports[`help output warden builds --help (and nested subcommands) 1`] = `
"$ warden builds --help
Usage: warden builds [options] [command]

list, prune (LRU) and import cached native app builds

Options:
  -h, --help      display help for command

Commands:
  ls              list cached builds (the default)
  prune           remove least-recently-used builds until the cache fits
                  --max-size (build-locked ones stay)
  import <path>   copy a local .app / .apk into the cache under a fingerprint
                  hash
  help [command]  display help for command

$ warden builds ls --help
Usage: warden builds ls [options]

list cached builds (the default)

Options:
  --json      machine-readable output
  -h, --help  display help for command

$ warden builds prune --help
Usage: warden builds prune [options]

remove least-recently-used builds until the cache fits --max-size (build-locked
ones stay)

Options:
  --max-size <size>  cache size limit, e.g. 20G (default: $WARDEN_MAX_CACHE_SIZE
                     or 20G; gc's --max-cache-size)
  --dry-run          only show what would be removed
  --yes              don't ask before removing
  --json             machine-readable output
  -h, --help         display help for command

$ warden builds import --help
Usage: warden builds import [options] <path>

copy a local .app / .apk into the cache under a fingerprint hash

Arguments:
  path                   path.app | path.apk

Options:
  --hash <hash>          fingerprint hash to file it under
  --platform <platform>  ios | android (default: from the extension)
  --project <dir>        project directory (default: cwd)
  --profile <profile>    build profile (default: the project's EAS profile, else
                         local)
  --bundle-id <id>       override the bundle id / package
  --json                 machine-readable output
  -h, --help             display help for command"
`;

exports[`help output warden hook --help (and nested subcommands) 1`] = `
"$ warden hook --help
Usage: warden hook [options] [command]

Claude Code / Codex hook: on session end shut down what the session booted +
release its leases

Options:
  -h, --help      display help for command

Commands:
  session-end     SessionEnd: shut down what the session booted + release its
                  leases (reads hook JSON on stdin)
  help [command]  display help for command

$ warden hook session-end --help
Usage: warden hook session-end [options]

SessionEnd: shut down what the session booted + release its leases (reads hook
JSON on stdin)

Options:
  -h, --help  display help for command"
`;

exports[`help output warden install --help (and nested subcommands) 1`] = `
"$ warden install --help
Usage: warden install [options]

install warden to ~/.local/bin + hooks for detected agents (Claude Code: skill,
rule, hook; Codex: hook)

Options:
  --claude         install for Claude Code (default: every detected agent)
  --codex          install for Codex (default: every detected agent)
  -y, --yes        apply agent-config changes without asking
  --dry-run        show what would change (diffs), write nothing
  --shim           running from source: link ~/.local/bin/warden to this
                   checkout
  --no-completion  don't set up tab completion for $SHELL
  --json           machine-readable output (diffs go to stderr)
  -h, --help       display help for command"
`;

exports[`help output warden init --help (and nested subcommands) 1`] = `
"$ warden init --help
Usage: warden init [options]

set an Expo app up for warden dev / warden e2e (warden.config.ts, a first spec)

Options:
  --project <dir>   the Expo app's directory (default: cwd)
  --bundle-id <id>  bundle id / package for an app that has none yet (written to
                    app.json)
  --force           overwrite files that already exist
  --dry-run         print what would be written, write nothing
  --json            machine-readable output
  -h, --help        display help for command

Example:
  warden init --bundle-id com.example.app"
`;

exports[`help output warden completion --help (and nested subcommands) 1`] = `
"$ warden completion --help
Usage: warden completion [options] [shell]

print the tab-completion script for zsh / bash / fish (\`warden install\` sets it
up)

Arguments:
  shell       default: $SHELL (choices: "zsh", "bash", "fish")

Options:
  -h, --help  display help for command

Load it in your shell:
  zsh   source <(warden completion zsh)
  bash  source <(warden completion bash)
  fish  warden completion fish | source"
`;

exports[`help output warden __complete --help (and nested subcommands) 1`] = `
"$ warden __complete --help
option	--help	display help for command"
`;

exports[`help output warden skill --help (and nested subcommands) 1`] = `
"$ warden skill --help
Usage: warden skill [options] [command]

the warden agent skill: show (copy/paste) | install (bunx/npx skills add)

Options:
  -h, --help      display help for command

Commands:
  show            print SKILL.md to copy/paste (e.g. \`warden skill show |
                  pbcopy\`)
  install         install via \`bunx skills add\` (npx fallback)
  help [command]  display help for command

$ warden skill show --help
Usage: warden skill show [options]

print SKILL.md to copy/paste (e.g. \`warden skill show | pbcopy\`)

Options:
  --file <path>  print one embedded file (references/ui.md, rules/warden.md, …)
  --json         machine-readable output
  -h, --help     display help for command

$ warden skill install --help
Usage: warden skill install [options]

install via \`bunx skills add\` (npx fallback)

Options:
  --from <source>         local = this binary's embedded copy; github = the
                          release repo (updatable) (choices: "local", "github",
                          default: "local")
  --project               install into the current project (default: global, -g)
  -a, --agent <agent...>  target agent(s), repeatable (default: the skills CLI
                          asks)
  --copy                  copy files instead of symlinking
  -y, --yes               skip the skills CLI's confirmations
  --dry-run               print the skills command, run nothing
  --json                  machine-readable output (with --dry-run: the command
                          as JSON)
  -h, --help              display help for command"
`;

exports[`help output warden doctor --help (and nested subcommands) 1`] = `
"$ warden doctor --help
Usage: warden doctor [options]

check warden's setup: home, db, device tools, simulator helper, install method,
PATH, Claude/Codex hooks + skill, stale leases

Options:
  --fetch-helper  download warden-simd for this version into
                  $WARDEN_HOME/simd/<version>/ first
  --json          machine-readable output
  -h, --help      display help for command"
`;

exports[`help output warden update --help (and nested subcommands) 1`] = `
"$ warden update --help
Usage: warden update [options]

update warden: rebuild from source (dev/local builds) or install the latest
release

Options:
  --check      only report whether an update is available
  --release    install the latest GitHub release (also switches a dev/local
               build to it)
  --force      reinstall even when up to date
  --to <path>  install the binary here instead
  --json       machine-readable output
  -h, --help   display help for command"
`;

exports[`help output warden version --help (and nested subcommands) 1`] = `
"$ warden version --help
Usage: warden version [options]

print warden's version and build channel (dev / local / release)

Options:
  --json      machine-readable output
  -h, --help  display help for command"
`;

exports[`help output unknown command suggests the closest registered one 1`] = `
"error: unknown command 'claime'
(Did you mean claim?)
(add --help for usage)"
`;
