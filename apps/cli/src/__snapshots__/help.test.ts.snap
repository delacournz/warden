exports[`help output warden heartbeat --help (and nested subcommands) 1`] = `
"$ warden heartbeat --help
Usage: warden heartbeat [options] [leaseIds...]

refresh lease heartbeats so they don't go stale

Arguments:
  leaseIds          lease ids to refresh

Options:
  --udid <udid...>  select leases of these device udids / serials (repeatable)
  --mine            select every lease held by this owner
  --label <label>   with --mine: only leases whose label equals this
  --session <id>    select every lease held by this agent session
  --json            machine-readable output
  -h, --help        display help for command"
`;

exports[`help output warden gc --help (and nested subcommands) 1`] = `
"$ warden gc --help
Usage: warden gc [options]

reclaim stale leases; shut down idle warden devices (never deletes)

Options:
  --idle <duration>        shut down unleased warden devices idle this long
                           (default: 20m)
  --max-cache-size <size>  prune least-recently-used cached builds down to this
                           size, e.g. 20G (default: $WARDEN_MAX_CACHE_SIZE or
                           20G; builds used in the last 30 min stay)
  --quiet                  print nothing (background auto-gc)
  --json                   machine-readable output
  -h, --help               display help for command"
`;

exports[`help output warden port --help (and nested subcommands) 1`] = `
"$ warden port --help
Usage: warden port [options] [command]

lease TCP ports from a range (bind-probed, never handed out twice)

Options:
  -h, --help          display help for command

Commands:
  claim               lease free port(s) from FROM..FROM+SPAN-1 (inclusive);
                      prints one port per line
  release [ports...]  release port leases: <port…> | --lease <id…> | --mine (own
                      leases only unless --force)
  ls                  list port leases
  help [command]      display help for command

$ warden port claim --help
Usage: warden port claim [options]

lease free port(s) from FROM..FROM+SPAN-1 (inclusive); prints one port per line

Options:
  --from <port>     first port of the range (default 8091)
  --span <n>        range size (default 20)
  --count <n>       how many ports (default 1)
  --ttl <duration>  lease TTL without heartbeat (default 30m)
  --label <label>   label shown in \`warden port ls\`
  --json            machine-readable output
  -h, --help        display help for command

$ warden port release --help
Usage: warden port release [options] [ports...]

release port leases: <port…> | --lease <id…> | --mine (own leases only unless
--force)

Arguments:
  ports            ports to release

Options:
  --lease <id...>  release these lease ids
  --mine           release all of your port leases
  --force          release leases held by someone else
  --json           machine-readable output
  -h, --help       display help for command

$ warden port ls --help
Usage: warden port ls [options]

list port leases

Options:
  --json      machine-readable output
  -h, --help  display help for command"
`;

exports[`help output warden app --help (and nested subcommands) 1`] = `
"$ warden app --help
Usage: warden app [options] [command]

fingerprint an Expo app and install the matching build (installed → cache → EAS
→ local build)

Options:
  -h, --help              display help for command

Commands:
  ensure [platform]       install the build matching the project's fingerprint
                          on a device (installed → cache → EAS → build)
  fingerprint [platform]  print the project's native fingerprint (both platforms
                          by default)
  help [command]          display help for command

$ warden app ensure --help
Usage: warden app ensure [options] [platform]

install the build matching the project's fingerprint on a device (installed →
cache → EAS → build)

Arguments:
  platform               ios | android (asked for when omitted in a terminal)

Options:
  --project <dir>        project directory (default: cwd)
  --lease <id>           device of this lease
  --udid <udid>          this device
  --no-install           only resolve the build into the cache
  --no-eas               don't download EAS builds
  --no-build             don't build locally on a cache miss
  --install-mode <mode>  clean = fresh app data each run without reinstalling an
                         unchanged build; reinstall = uninstall + install each
                         run (default: install only when the build differs)
                         (choices: "clean", "reinstall")
  --reset-keychain       --install-mode: also reset the iOS simulator's keychain
  --bundle-id <id>       override the bundle id / package
  --variant <name>       use this projects[].variants build (dev, e2e…)
  --json                 machine-readable output
  -h, --help             display help for command

$ warden app fingerprint --help
Usage: warden app fingerprint [options] [platform]

print the project's native fingerprint (both platforms by default)

Arguments:
  platform          ios | android

Options:
  --project <dir>   project directory (default: cwd)
  --bundle-id <id>  override the bundle id / package
  --variant <name>  fingerprint this projects[].variants build
  --json            machine-readable output
  -h, --help        display help for command"
`;

exports[`help output warden ui --help (and nested subcommands) 1`] = `
"$ warden ui --help
Usage: warden ui [options] [command]

drive a leased simulator / emulator (agents): status, snapshot, find, open,
press, fill, scroll, …

Options:
  -h, --help                   display help for command

Commands:
  status                       device, lease and helper state
  close                        stop this device's helper (the lease stays);
                               --app also quits the app, --release frees the
                               lease
  snapshot                     the screen as @eN lines (bumps the generation)
  find <selector...>           elements matching a selector, with @eN refs
                               (bumps the generation)
  open <target>                launch an app (bundle id) or open a URL; --metro
                               starts the dev client on that Metro
  press <target...>            tap an element or point; an @eN older than 30 s
                               is re-verified first
  tap <target...>              tap an element or point; an @eN older than 30 s
                               is re-verified first
  fill <args...>               replace a text field's content, then read it back
                               (use -- before text starting with -)
  type <text>                  type into whatever has focus
  key <name>                   press a key: Enter Backspace Tab Space Escape
                               Delete Up Down Left Right
  scroll <direction> [amount]  scroll content: scroll down reveals what is
                               below; --until swipes until a selector is on
                               screen
  alert <action>               answer the system alert / sheet on top, or read
                               it
  home                         press the home button
  back                         press back (Android only)
  screen                       the device screen: orientation, appearance,
                               screenshot, video
  gesture                      touch gestures: swipe, longpress, pinch, rotate,
                               raw paths
  wait <args...>               poll (100 ms, --timeout) until an element is
                               visible; also: absent <sel> | text <…> | stable
                               [ms]
  is <args...>                 exit 0 when the element is in that state, 1 when
                               not
  get <args...>                print one property of an element (count = how
                               many match)
  bench                        time snapshot, press, settle, tree and driver
                               open on this device against the speed targets
  eval <expression>            run JavaScript in the app (Hermes) and print the
                               value
  tree                         the app's React components (testID, label, text,
                               screen) with rects
  logs [args...]               app console: logs [n] | start | stop | mark
                               <label> | clear
  network [n]                  the app's fetch calls recorded by \`logs start\`
  reload                       reload the app's JavaScript
  help [command]               display help for command

$ warden ui status --help
Usage: warden ui status [options]

device, lease and helper state

Options:
  --udid <udid>          device udid (iOS) / serial (Android)
  --serial <serial>      Android serial
  --lease <id>           use the device behind this lease id
  --claim                take over a stale/missing lease, or claim a device when
