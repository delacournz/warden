{
	"name": "@delacour/warden",
	"version": "0.12.1",
	"description": "Give every AI coding agent its own iOS simulator or Android emulator: machine-wide leasing of devices, ports and app builds, plus TypeScript e2e testing for React Native and Expo",
	"homepage": "https://warden.co.nz",
	"license": "MIT",
	"type": "module",
	"private": true,
	"bin": {
		"warden": "./src/cli.ts"
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"install:global": "bun src/cli.ts update",
		"link": "bun scripts/link.ts link",
		"unlink": "bun scripts/link.ts unlink",
		"fmt": "biome format --write ./src ./scripts",
		"lint": "biome lint --write ./src ./scripts",
		"check": "biome check ./src ./scripts",
		"typecheck": "tsc --noEmit",
		"test": "bun test --parallel --timings=test-timings.json --timeout 20000",
		"test:timings": "bun test --parallel --timings=test-timings.json --timeout 20000 --update-timings",
		"build:release": "bun scripts/build.ts --channel release",
		"build:npm": "bun scripts/npm-packages.ts",
		"build:helper-asset": "bun scripts/helper-asset.ts"
	},
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"@commander-js/extra-typings": "^15.0.0",
		"@delacour/warden-core": "workspace:*",
		"@delacour/warden-e2e": "workspace:*",
		"@delacour/warden-perf": "workspace:*",
		"@delacour/warden-types": "workspace:*",
		"@delacournz/cli-telemetry": "^0.1.0",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@xterm/headless": "6",
		"chalk": "^6.0.1",
		"commander": "^15.0.0",
		"ora": "^9.4.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@delacour/warden-tsconfig": "workspace:*",
		"typescript": "^5.9.3"
	}
}
