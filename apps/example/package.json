{
  "name": "@delacour/warden-example",
  "version": "0.0.0",
  "main": "index.ts",
  "dependencies": {
    "@central-icons-react-native/round-outlined-radius-1-stroke-1.5": "^1.2.1",
    "@legendapp/list": "^3.6.0",
    "clsx": "^2.1.1",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-pulsar": "^1.7.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.1"
  },
  "devDependencies": {
    "@e2e-dev/mobile": "0.9.2",
    "@types/bun": "^1.3.8",
    "@types/react": "~19.2.2",
    "e2e": "0.17.0",
    "typescript": "~6.0.3",
    "@delacour/warden-core": "workspace:*"
  },
  "scripts": {
    "prebuild": "bun expo prebuild",
    "ensure-prebuild": "bun scripts/ensure-prebuild.ts",
    "start": "bun ensure-prebuild && bun expo start --dev-client --clear",
    "dev": "bun ensure-prebuild && bun expo start --dev-client --clear --port 8095",
    "android": "bun ensure-prebuild && expo run:android --device --port 8095",
    "ios": "bun ensure-prebuild && expo run:ios --device --port 8095",
    "check": "biome check ./src ./scripts",
    "fmt": "biome format --write ./src ./scripts",
    "lint": "biome lint --write ./src ./scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "e2e": "bun ../cli/src/cli.ts e2e example",
    "e2e:affected": "bun ../cli/src/cli.ts affected example",
    "e2e:flow": "bun ../cli/src/cli.ts e2e example --flows"
  },
  "private": true
}
