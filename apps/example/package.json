{
  "name": "@delacour/warden-example",
  "version": "0.0.0",
  "main": "index.ts",
  "dependencies": {
    "@central-icons-react-native/round-outlined-radius-1-stroke-1.5": "^1.2.1",
    "@delacour/react-native-bottom-sheet": "^0.3.0",
    "@expo-google-fonts/martian-mono": "^0.4.2",
    "@expo-google-fonts/mona-sans": "^0.4.1",
    "@legendapp/list": "^3.6.0",
    "@react-native-community/netinfo": "12.0.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "expo": "~58.0.23",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-pulsar": "^1.7.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-teleport": "^1.2.3",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.13.1"
  },
  "devDependencies": {
    "@delacour/warden-core": "workspace:*",
    "@delacour/warden-e2e": "workspace:*",
    "@types/bun": "^1.3.8",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prebuild": "bun expo prebuild",
    "ensure-prebuild": "bun scripts/ensure-prebuild.ts",
    "start": "bun ensure-prebuild && bun expo start --dev-client --clear",
    "dev": "bun ensure-prebuild && bun expo start --dev-client --clear --port 8095",
    "android": "bun ../cli/src/cli.ts dev android",
    "ios": "bun ../cli/src/cli.ts dev ios",
    "check": "biome check ./src ./scripts ./e2e",
    "fmt": "biome format --write ./src ./scripts ./e2e",
    "lint": "biome lint --write ./src ./scripts ./e2e",
    "typecheck": "tsc --noEmit",
    "test": "bun test src e2e/helpers",
    "e2e": "bun ../cli/src/cli.ts e2e example",
    "e2e:dev": "bun ../cli/src/cli.ts e2e example --dev",
    "e2e:affected": "bun ../cli/src/cli.ts affected example",
    "e2e:spec": "bun ../cli/src/cli.ts e2e example --specs"
  },
  "private": true
}
