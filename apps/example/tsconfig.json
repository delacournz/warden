{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "react-native": [
        "../../node_modules/react-native/types_generated/index.d.ts"
      ],
      "react-native/*": [
        "../../node_modules/react-native/*"
      ]
    },
    "types": [
      "bun"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
