{
	"name": "@delacour/warden-viewer",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tauri dev",
		"dev:frontend": "vite",
		"build:frontend": "tsc --noEmit && vite build",
		"tauri": "tauri",
		"tauri:build": "tauri build",
		"pack:asset": "bun scripts/pack-asset.ts",
		"icons": "bun scripts/icons.ts",
		"typecheck": "tsc --noEmit",
		"fmt": "biome format --write ./src ./scripts",
		"lint": "biome lint --write ./src ./scripts",
		"check": "biome check ./src ./scripts",
		"test": "bun test",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-router": "1.170.27",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2",
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"optionalDependencies": {
		"@delacournz/apogee": "^0.1.0"
	},
	"devDependencies": {
		"@delacour/warden-tsconfig": "workspace:*",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-plugin": "^1",
		"@tauri-apps/cli": "^2",
		"@types/bun": "latest",
		"@types/react": "19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.1"
	}
}
