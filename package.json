{
	"name": "@warden/source",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.3.14",
	"scripts": {
		"postinstall": "git rev-parse --git-dir > /dev/null 2>&1 && prek install || true",
		"dev": "turbo dev --ui tui",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"check": "turbo check",
		"lint": "turbo lint",
		"fmt": "turbo fmt",
		"test": "turbo test",
		"nuke": "rm -rf node_modules ./apps/**/node_modules ./packages/**/node_modules && bun install --no-cache -f"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@j178/prek": "^0.3.5",
		"@warden/biome-config": "workspace:*",
		"@warden/tsconfig": "workspace:*",
		"@types/bun": "^1.3.8",
		"@types/node": "^22.15.0",
		"turbo": "^2.8.2",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"mdast-util-to-markdown": "2.1.2"
	}
}
