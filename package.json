{
	"name": "@delacour/warden-source",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.3",
	"scripts": {
		"postinstall": "git rev-parse --git-dir > /dev/null 2>&1 && prek install || true",
		"dev": "turbo dev --ui tui",
		"dev:web": "turbo dev --filter=@delacour/warden-docs",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"check": "turbo check",
		"lint": "turbo lint",
		"fmt": "turbo fmt",
		"test": "turbo test",
		"release": "bun apps/cli/scripts/release.ts",
		"changeset": "changeset",
		"version": "changeset version && bun install --lockfile-only",
		"cli:link": "bun apps/cli/scripts/link.ts link",
		"cli:unlink": "bun apps/cli/scripts/link.ts unlink",
		"smoke:ui-bench": "bun scripts/smoke/ui-bench.ts",
		"demo:compose": "bun scripts/demo/compose.ts",
		"demo:fixture": "bun scripts/demo/fixture.ts",
		"nuke": "rm -rf node_modules ./apps/**/node_modules ./packages/**/node_modules && bun install --no-cache -f",
		"bench": "bun packages/e2e-bench/src/cli.ts",
		"signoff": "bun scripts/signoff/signoff.ts"
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"scripts/demo",
		"scripts/release",
		"scripts/signoff",
		"scripts/smoke"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@delacour/warden-biome-config": "workspace:*",
		"@delacour/warden-tsconfig": "workspace:*",
		"@j178/prek": "^0.3.5",
		"@types/bun": "^1.3.8",
		"@types/node": "^22.15.0",
		"turbo": "^2.8.2",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"mdast-util-to-markdown": "2.1.2",
		"@delacournz/otel": "0.1.0"
	},
	"patchedDependencies": {
		"react-native-pulsar@1.7.0": "patches/react-native-pulsar@1.7.0.patch"
	}
}
