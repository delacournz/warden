{
	"name": "@delacour/warden-e2e",
	"version": "0.7.0",
	"description": "warden e2e: TypeScript spec API (bun test), simulator/emulator driver, RN devtools facet",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./authoring/codegen": "./src/authoring/codegen.ts",
		"./authoring/journal": "./src/authoring/journal.ts",
		"./authoring/lint": "./src/authoring/lint.ts",
		"./authoring/recording.schema": "./src/authoring/recording.schema.ts",
		"./authoring/secrets": "./src/authoring/secrets.ts",
		"./authoring/status": "./src/authoring/status.ts",
		"./authoring/target": "./src/authoring/target.ts",
		"./env": "./src/env.ts",
		"./preload": "./src/preload.ts",
		"./runner/results": "./src/runner/results.ts",
		"./runner/trace": "./src/runner/trace.ts"
	},
	"scripts": {
		"fmt": "biome format --write ./src ./scripts",
		"lint": "biome lint --write ./src ./scripts",
		"check": "biome check ./src ./scripts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"native:smoke": "bun scripts/smoke.ts"
	},
	"dependencies": {
		"@delacour/warden-config": "workspace:*",
		"@delacour/warden-device": "workspace:*",
		"@delacour/warden-devtools": "workspace:*",
		"@delacour/warden-driver": "workspace:*",
		"@delacour/warden-driver-android": "workspace:*",
		"@delacour/warden-driver-ios": "workspace:*",
		"@delacour/warden-providers": "workspace:*",
		"@delacour/warden-runtime": "workspace:*",
		"@delacour/warden-screen": "workspace:*",
		"@delacour/warden-store": "workspace:*",
		"@delacour/warden-types": "workspace:*",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@delacour/warden-tsconfig": "workspace:*"
	}
}
