{
	"name": "@delacour/warden-e2e",
	"version": "0.1.0",
	"description": "warden e2e: TypeScript spec API (bun test), simulator/emulator driver, RN devtools facet, recorded flows",
	"type": "module",
	"private": true,
	"exports": {
		"./*": "./src/*.ts"
	},
	"scripts": {
		"fmt": "biome format --write ./src ./native/scripts",
		"lint": "biome lint --write ./src ./native/scripts",
		"check": "biome check ./src ./native/scripts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"native:deps": "bun native/scripts/deps.ts",
		"native:build": "bun native/scripts/build.ts",
		"native:smoke": "bun native/scripts/smoke.ts"
	},
	"dependencies": {
		"@delacour/warden-core": "workspace:*",
		"@delacour/warden-types": "workspace:*",
		"zod": "^4.4.3",
		"typescript": "^5.9.3"
	},
	"devDependencies": {
		"@delacour/warden-tsconfig": "workspace:*"
	}
}
