{
	"name": "@delacour/warden-core",
	"version": "0.1.0",
	"description": "warden core: lease store, allocation, device providers, build cache",
	"type": "module",
	"private": true,
	"exports": {
		"./*": "./src/*.ts"
	},
	"scripts": {
		"fmt": "biome format --write ./src",
		"lint": "biome lint --write ./src",
		"check": "biome check ./src",
		"typecheck": "tsc --noEmit",
		"test": "bun test --parallel --timings=test-timings.json --timeout 20000",
		"test:timings": "bun test --parallel --timings=test-timings.json --update-timings"
	},
	"dependencies": {
		"@delacour/warden-types": "workspace:*",
		"zod": "^4.4.3",
		"typescript": "^5.9.3"
	},
	"devDependencies": {
		"@delacour/warden-tsconfig": "workspace:*"
	}
}
