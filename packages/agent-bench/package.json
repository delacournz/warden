{
	"name": "@delacour/warden-agent-bench",
	"version": "0.1.0",
	"description": "Agent-in-the-loop benchmark: a Claude Code agent drives the example app through warden with the warden skill; counts tool calls, stumbles and wall time",
	"type": "module",
	"private": true,
	"scripts": {
		"bench:agent": "bun src/cli.ts",
		"fmt": "biome format --write ./src ./suites",
		"lint": "biome lint --write ./src ./suites",
		"check": "biome check ./src ./suites",
		"typecheck": "tsc --noEmit",
		"test": "bun test src"
	},
	"dependencies": {
		"@delacour/warden-e2e-bench": "workspace:*",
		"@delacour/warden-types": "workspace:*",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@delacour/warden-tsconfig": "workspace:*",
		"typescript": "^5.9.3"
	}
}
