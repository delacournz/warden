open nz.co.delacour.warden.example --relaunch
wait "id=\"welcome-screen\"" 30000
press "id=\"welcome-next\""
wait "id=\"welcome-title\" text=\"Plan\"" 4000
press "id=\"welcome-next\""
wait "id=\"welcome-title\" text=\"Test\"" 4000
press "id=\"welcome-get-started\""
wait "id=\"sign-in-screen\"" 4000
fill "id=\"sign-in-email\"" "ada@example.com"
fill "id=\"sign-in-password\"" "password1"
press "id=\"sign-in-submit\""
wait "id=\"todos-screen\"" 15000
press "id=\"todo-title-welcome\""
wait "id=\"todo-detail-title\" text=\"Explore the example app\"" 4000
wait "text=\"Active\"" 4000
press "id=\"todo-detail-toggle\""
wait "text=\"Done\"" 4000
press "id=\"todo-detail-delete\""
wait "id=\"todos-screen\"" 4000
wait absent "id=\"todo-row-welcome\"" 4000
