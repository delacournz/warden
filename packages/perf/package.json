{
	"name": "@delacour/warden-perf",
	"version": "0.1.0",
	"description": "warden perf: pure capture argv builders, parsers and analyzers for mobile app profiling",
	"type": "module",
	"private": true,
	"exports": {
		"./*": "./src/*.ts"
	},
	"scripts": {
