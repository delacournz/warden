		"test": "bun test"
	},
	"dependencies": {
		"@jridgewell/trace-mapping": "^0.3.31",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@delacour/warden-tsconfig": "workspace:*",
		"typescript": "^5.9.3"
	}
}
